        { "id": "ai-edit", "supported": true, "summary": "AI 修改已打开的表格，修改前确认" },
        { "id": "ai-animation", "supported": true, "summary": "AI 写入时选中区域并显示 Agent 框；不超过 48 格逐格填入并高亮当前格，更大的区域逐行写入" },
        { "id": "ai-selection-rewrite", "supported": true, "summary": "选中一块连续单元格（最多 200 格）后点「AI 改写」，AI 只改这些格子，改完可保留或撤回" },
        { "id": "ai-charts", "supported": true, "summary": "按数据区域生成簇状柱形图" },
        { "id": "ai-undo", "supported": false, "summary": "AI 修改不能自动撤销，出错或停止时保留已完成步骤" },
        { "id": "print", "supported": false, "summary": "暂不提供打印" }
      ],
      "aiTools": ["spreadsheet_create", "spreadsheet_read", "spreadsheet_edit", "spreadsheet_save", "selection_rewrite"]
    }
