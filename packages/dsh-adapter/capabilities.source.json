    {
      "id": "document",
      "name": { "zh": "Word", "en": "Word" },
      "extensions": ["docx"],
      "capabilities": [
        { "id": "preview", "supported": true, "summary": "右侧标签页打开预览，带修订的文档原样显示修订" },
