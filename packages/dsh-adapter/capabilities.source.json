        { "id": "ai-create", "supported": true, "summary": "AI 按模板新建并实时逐段写入" },
        { "id": "ai-edit", "supported": true, "summary": "AI 修改已打开的文档，修改前确认" },
        { "id": "ai-animation", "supported": true, "summary": "AI 写入时显示 Agent 框与步骤；新段落和整段改写的文字分几次长出" },
