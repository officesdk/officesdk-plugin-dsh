        { "id": "ai-create", "supported": true, "summary": "AI 新建并在编辑器里实时逐页生成" },
        { "id": "ai-edit", "supported": true, "summary": "AI 修改已打开的 PPT，修改前在标签页确认" },
        { "id": "ai-animation", "supported": true, "summary": "AI 写入时显示 Agent 框、光标与打字效果" },
        { "id": "ai-selection-rewrite", "supported": false, "summary": "选中文字 AI 改写暂不支持 PPT" },
        { "id": "ai-undo", "supported": true, "summary": "撤销 AI 修改（整批回滚）" },
