    { "id": "edit-view-mode", "supported": true, "summary": "编辑模式 / 阅读模式切换" },
    { "id": "disk-change", "supported": true, "summary": "文件被其他程序改写时自动重载或询问用磁盘版本还是保留修改" },
    { "id": "plugin-update", "supported": true, "summary": "插件内检查并一键更新到 dist 最新版本" },
    { "id": "whats-new", "supported": true, "summary": "更新后第一次打开文档时提示本次更新要点" }
  ],
  "products": [
    {
      "id": "presentation",
      "name": { "zh": "PPT", "en": "Presentation" },
