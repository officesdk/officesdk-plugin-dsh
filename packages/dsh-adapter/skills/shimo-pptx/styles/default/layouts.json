        "vars": {"closing": false},
        "fields": {"title": {"type": "text"}, "subtitle": {"type": "text"}, "year": {"type": "text"}},
        "let": {
          "sub": "d.get('subtitle', deck.get('subtitle', ''))",
          "title": "d.get('title') or ('THANKS' if closing else deck.get('title', ''))"
        },
        "objects": [
          {"type": "logo", "dark": true, "x": 50, "y": 118, "w": 108, "max_h": 26},
          {"type": "text", "when": "sub", "text": "sub", "x": 518, "y": 122, "w": 412, "size": 28, "color": "onPrimary", "weight": 300, "lh": 1.13, "wrap": false},
          {"type": "hline", "x": 0, "y": 221, "w": 960, "color": "lineOnPrimary"},
          {"type": "text", "text": "title", "x": 50, "y": "362 if closing or len(lines(title)) == 1 else 249", "w": 787, "size": "fit(title, 110, 700)", "color": "onPrimary", "weight": 300, "lh": 0.96, "wrap": false},
          {"type": "arrow", "x": 790, "y": 349, "size": 70, "color": "onPrimary"},
          {"type": "text", "text": "str(d.get('year') or year())", "x": 763, "y": 426, "w": 176, "size": 40, "color": "onPrimary", "weight": 300, "wrap": false, "name": "year"}
        ]
      },
